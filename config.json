{
  "connections_prometheus_url": "http://k8s.az1.danivy.com:8080/prometheus",
  "metrics": {
    "cpu_throttle_time": [
      "max"
    ],
    "cpu_usage": [
      "25th%",
      "75th%",
      "max"
    ],
    "memory_usage": [
      "25th%",
      "75th%",
      "max"
    ],
    "out_of_memory_kills": [
      "max"
